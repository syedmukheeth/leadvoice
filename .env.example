# LeadVoice web app settings. Copy to .env.local (or add them in Vercel: Settings > Environment Variables).
# GOOGLE_API_KEY and SARVAM_API_KEY are also read from ../telugu-agent/.env automatically,
# so locally you only need them here if the voice agent folder is elsewhere.

GOOGLE_API_KEY=            # Gemini: live calls (Gemini Live) and step-by-step call replies
SARVAM_API_KEY=            # Sarvam: speech-to-text, natural voices and voice samples
LLM_DRAFT_MODEL=gemini-3.5-flash-lite
# LLM_TEST_MODEL=          # optional: Gemini model to try first for step-by-step calls
# LIVE_MODEL=gemini-3.8-live  # optional: Gemini Live model for live calls

# Site password gate. Required on Vercel (the site stays locked until it is set); optional locally.
SITE_PASSWORD=
