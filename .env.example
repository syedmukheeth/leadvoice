# LeadVoice web app settings. Copy to .env.local.
# GOOGLE_API_KEY and SARVAM_API_KEY are also read from ../telugu-agent/.env automatically,
# so you only need them here if the voice agent folder is elsewhere.

GOOGLE_API_KEY=            # Gemini: writes call scripts in the hire wizard
SARVAM_API_KEY=            # Sarvam: voice samples
LLM_DRAFT_MODEL=gemini-3.5-flash-lite

# --- Phase 1b: accounts + database (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # server only, never in the browser
